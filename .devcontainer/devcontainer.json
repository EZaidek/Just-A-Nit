{
  "name": "Just-A-Nit",
  "dockerComposeFile": "../compose.yaml",
  "service": "web",
  "workspaceFolder": "/app",
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"],
      "settings": {
        "editor.tabSize": 2,
        "files.eol": "\n"
      }
    }
  }
}
